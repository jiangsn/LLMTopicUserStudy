# Local pilot defaults
VITE_STORAGE_ENGINE=localStorage
VITE_BASE_PATH=/
VITE_GITHUB_REPO_URL=
VITE_LAUNCH_READY=false
VITE_REQUIRE_PROLIFIC_PARAMS=false

# Firebase production configuration used by reVISit (both required before launch).
# Keep the Firebase web config as a single quoted HJSON/JSON object.
VITE_FIREBASE_CONFIG=
VITE_RECAPTCHAV3TOKEN=

# Study launch details (all required before production build)
STUDY_CONTACT_EMAIL=
STUDY_CONSENT_APPROVED=false
PROLIFIC_COMPLETION_URL=
FIREBASE_RULES_TESTED=false
